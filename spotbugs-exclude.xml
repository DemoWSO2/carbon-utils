<FindBugsFilter>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match> 

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.JdbcTemplate"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.JdbcTemplate"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.JdbcTemplate"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.Template"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.JdbcUtils"/>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.JdbcUtils"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.NamedTemplate"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.NamedJdbcTemplate"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.NamedJdbcTemplate"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.ExecuteCallable"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.NamedExecuteCallable"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    
    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.TransactionEntry"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <Match>
        <Class name="org.wso2.carbon.database.utils.jdbc.TransactionEntry"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>